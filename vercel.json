{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "installCommand": "npm install",
  "framework": "vite",
  "cleanUrls": false,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" },
        { "key": "Strict-Transport-Security", "value": "max-age=63072000; includeSubDomains" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=(), payment=(), usb=(), interest-cohort=()" },
        { "key": "Content-Security-Policy-Report-Only", "value": "default-src 'self'; script-src 'self' 'unsafe-inline' https://use.typekit.net https://www.googletagmanager.com https://challenges.cloudflare.com; style-src 'self' 'unsafe-inline' https://use.typekit.net https://p.typekit.net https://fonts.googleapis.com; font-src 'self' data: https://use.typekit.net https://fonts.gstatic.com; img-src 'self' data: blob: https:; connect-src 'self' https://dgfmoibynftadsyjcclg.supabase.co https://*.google-analytics.com https://www.googletagmanager.com https://p.typekit.net; frame-src https://challenges.cloudflare.com; worker-src 'self'; frame-ancestors 'self'; base-uri 'self'; form-action 'self'; object-src 'none'" }
      ]
    },
    {
      "source": "/",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/index.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/organizacao/sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/marca/sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/painel/sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, max-age=0, must-revalidate"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/painel/",
      "destination": "/painel-app/index.html"
    },
    {
      "source": "/quero-participar",
      "destination": "/quero-participar/index.html"
    },
    {
      "source": "/mapa",
      "destination": "/"
    },
    {
      "source": "/rota",
      "destination": "/"
    },
    {
      "source": "/participantes",
      "destination": "/"
    },
    {
      "source": "/vencedores",
      "destination": "/"
    },
    {
      "source": "/premiacao",
      "destination": "/"
    },
    {
      "source": "/edicoes",
      "destination": "/"
    },
    {
      "source": "/curiosidades",
      "destination": "/"
    },
    {
      "source": "/participar",
      "destination": "/"
    },
    {
      "source": "/apoiar",
      "destination": "/"
    },
    {
      "source": "/contato",
      "destination": "/"
    },
    {
      "source": "/edicoes/:path*",
      "destination": "/"
    },
    {
      "source": "/lovers/:path*",
      "destination": "/"
    }
  ],
  "redirects": [
    {
      "source": "/organizacao",
      "destination": "/painel/",
      "permanent": false
    },
    {
      "source": "/organizacao/",
      "destination": "/painel/",
      "permanent": false
    },
    {
      "source": "/marca",
      "destination": "/painel/",
      "permanent": false
    },
    {
      "source": "/marca/",
      "destination": "/painel/",
      "permanent": false
    },
    {
      "source": "/painel",
      "destination": "/painel/",
      "permanent": false
    }
  ]
}
